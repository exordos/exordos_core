[DEFAULT]
verbose = True
debug = True

[db]
connection_url = postgresql://postgres:1234@172.17.0.2:5432/exordos_core
connection_pool_size = 2

[metrics]
enabled = False

[logging]
config = logging.yaml

[user_api]
bind_host = 0.0.0.0
bind_port = 11010
workers = 1

[iam]
# Base URL the clients of the API see. Set it when the proxy in front of the
# API does not send X-Forwarded-* headers: the OIDC endpoints and the issuer of
# the issued tokens are built from it.
public_base_url = https://iam.example.com

[orch_api]
bind_host = 0.0.0.0
bind_port = 11011
